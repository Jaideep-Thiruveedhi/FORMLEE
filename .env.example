# Formlee production environment template for Render.
# Replace placeholders in the host's secret environment settings; never commit real values.

# Mandatory production settings
DATABASE_URL=REPLACE_WITH_RENDER_POSTGRESQL_TLS_URL
DIRECT_DATABASE_URL=REPLACE_WITH_RENDER_DIRECT_POSTGRESQL_TLS_URL
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=https://formlee.example.invalid
DOCUMENT_STORAGE_PROVIDER=r2
AGENT_MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY
OPENROUTER_MODEL=REPLACE_WITH_PROVIDER/MODEL_ID

# Required when DOCUMENT_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=REPLACE_WITH_32_CHARACTER_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=REPLACE_WITH_R2_BUCKET_NAME

# Optional Razorpay billing. Leave all four unset to keep billing disabled.
# If enabled, set all four values and make NEXT_PUBLIC_RAZORPAY_KEY_ID match RAZORPAY_KEY_ID.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=REPLACE_WITH_RAZORPAY_PUBLIC_KEY_ID
# RAZORPAY_KEY_ID=REPLACE_WITH_RAZORPAY_KEY_ID
# RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_KEY_SECRET
# RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET

# Optional only when DOCUMENT_STORAGE_PROVIDER=local and the host volume persists.
# FORMLEE_STORAGE_DIR=/var/lib/formlee/uploads
